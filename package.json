{
  "name": "marktexset",
  "version": "0.1.0",
  "description": "Markdown publishing for mathematical documents",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrtk98/MarkTeXset.git"
  },
  "homepage": "https://github.com/skrtk98/MarkTeXset#readme",
  "bugs": {
    "url": "https://github.com/skrtk98/MarkTeXset/issues"
  },
  "keywords": [
    "markdown",
    "math",
    "mathjax",
    "pdf",
    "typesetting",
    "japanese"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "marktexset": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "quality": "tsx scripts/quality.ts"
  },
  "dependencies": {
    "@vivliostyle/core": "^2.45.2",
    "hyphen": "^1.14.1",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax-full": "^3.2.2",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "shiki": "^4.3.1",
    "ws": "^8.21.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
