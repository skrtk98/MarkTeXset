    "mathjax-full": "^3.2.2",
    "opentype.js": "^2.0.0",
    "playwright": "^1.61.1",
    "shiki": "^4.3.1",
    "ws": "^8.21.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
